<!DOCTYPE html>
<html lang="zh-TW">
  <head>
    <script>
      (function() {
        var s = localStorage.getItem('fairprice:font-size');
        if (s && ['14','15','16','17','18'].indexOf(s) !== -1) {
          document.documentElement.style.fontSize = s + 'px';
        }
      })();
    </script>
    <title><%= content_for(:title).presence || "FairPrice" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.3/Sortable.min.js"></script>
    <%# Phase I：html-to-image 改 vendor 本地檔（版本釘死），daily_momentum 匯出與 LEAPS 匯出共用 %>
    <%= javascript_include_tag "html-to-image-1.11.11" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.css">
    <script src="https://cdn.jsdelivr.net/npm/nprogress@0.2.0/nprogress.min.js"></script>
    <script>
      NProgress.configure({ showSpinner: false, speed: 300, minimum: 0.15 });
      document.addEventListener('DOMContentLoaded', function () {
        NProgress.done();
        document.addEventListener('click', function (e) {
          var link = e.target.closest('a[href]');
          if (!link) return;
          var href = link.getAttribute('href');
          if (!href || href.startsWith('#') || href.startsWith('javascript') || link.target === '_blank') return;
          NProgress.start(); NProgress.set(0.4);
        });
        document.addEventListener('submit', function () {
          NProgress.start(); NProgress.set(0.4);
        });
      });
    </script>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
    <%# 頁面行為的統一掛載點（稽核 H-3）：掃描 [data-behavior]，只動態載入
        該頁真正用到的模組。取代原本散在各 Phlex 元件裡的 inline <script>。
        新增 behavior 不需要動這個 layout。 %>
    <%= vite_typescript_tag 'behaviors.ts' %>
    <% if controller_name == 'leaps_recommendations' %>
      <%= javascript_include_tag "jspdf-2.5.2.umd.min" %>
      <%= javascript_include_tag "jspdf-autotable-3.8.4" %>
      <%= javascript_include_tag "driver-1.6.0.iife" %>
      <%= stylesheet_link_tag "driver-1.6.0" %>
      <%# 原本內嵌於 page_component.rb 的靜態 JS（零 Ruby 插值）拆成獨立 asset 檔，
          defer 讓執行時機等效於原本「放在 body 尾端」（元素查找是立即執行、非包在
          DOMContentLoaded 裡），搬進 head 若不加 defer 會抓不到還沒渲染的 DOM 元素。 %>
      <%= javascript_include_tag "leaps_recommendations/export", defer: true %>
      <%= javascript_include_tag "leaps_recommendations/vector_pdf", defer: true %>
      <%= javascript_include_tag "leaps_recommendations/tooltips", defer: true %>
      <%= javascript_include_tag "leaps_recommendations/sortable_table", defer: true %>
      <%= javascript_include_tag "leaps_recommendations/price_estimator", defer: true %>
    <% end %>
    <% if controller_name == 'users' && controller_path == 'admin/users' %>
      <%= javascript_include_tag "jspdf-2.5.2.umd.min" %>
    <% end %>
    <% if controller_name == 'bull_put_spreads' %>
      <%= javascript_include_tag "driver-1.6.0.iife" %>
      <%= stylesheet_link_tag "driver-1.6.0" %>
    <% end %>
    <% if controller_name == 'bull_call_spreads' %>
      <%= javascript_include_tag "driver-1.6.0.iife" %>
      <%= stylesheet_link_tag "driver-1.6.0" %>
    <% end %>
    <% if controller_name == 'ownership' %>
      <%= vite_javascript_tag 'ownership.tsx' %>
    <% end %>
    <% if controller_name == 'options' %>
      <%= vite_javascript_tag 'options.tsx' %>
    <% end %>
    <% if controller_name == 'reports' %>
      <%= vite_javascript_tag 'technicals.tsx' %>
    <% end %>
    <% if controller_name == 'margin' %>
      <%= vite_javascript_tag 'margin.tsx' %>
    <% end %>
    <% if controller_name == 'option_price_tracker' %>
      <%= vite_javascript_tag 'option_price_tracker.tsx' %>
    <% end %>
    <% if controller_name == 'option_profit_calc' %>
      <%= vite_javascript_tag 'option_profit_calc.tsx' %>
    <% end %>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">

    <%= render FairValue::NavbarComponent.new(
          ticker:        @ticker,
          discount_rate: @discount_rate.to_f,
          show_search:   @ticker.present?
        ) %>

    <% if controller_name == 'ownership' || controller_name == 'options' || controller_name == 'margin' || controller_name == 'option_price_tracker' || controller_name == 'option_profit_calc' %>
      <main class="flex-1 overflow-hidden flex flex-col">
        <%= yield %>
      </main>
    <% else %>
      <main class="flex-1 overflow-y-auto px-6 py-6">
        <% if flash[:notice] %>
          <div class="mb-4 px-4 py-3 bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg flex items-center gap-2">
            <span>✅</span><span><%= flash[:notice] %></span>
          </div>
        <% end %>
        <% if flash[:alert] %>
          <div class="mb-4 px-4 py-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg flex items-center gap-2">
            <span>⚠️</span><span><%= flash[:alert] %></span>
          </div>
        <% end %>
        <div class="w-full px-6">
          <%= yield %>
        </div>
      </main>

      <footer class="border-t border-gray-200 bg-white py-4">
        <p class="text-center text-xs text-gray-400">
          FairPrice — 數據來源 Finnhub ｜ 僅供參考，不構成投資建議
          <span class="ml-2 text-gray-300 font-mono"><%= app_version %></span>
          <button type="button" id="release-notes-btn" class="ml-2 text-blue-500 hover:text-blue-700 underline underline-offset-2">版本更新說明</button>
        </p>
      </footer>

      <div id="release-notes-overlay" class="release-notes-overlay hidden">
        <div class="release-notes-panel">
          <div class="release-notes-header">
            <h3 class="release-notes-title">版本更新說明 <span class="release-notes-version"><%= app_version %></span></h3>
            <button type="button" id="release-notes-close" class="release-notes-close" aria-label="關閉">✕</button>
          </div>
          <div class="release-notes-body">
            <p class="release-notes-note-title"><%= latest_release_note[:title] %></p>
            <ul>
              <% latest_release_note[:items].each do |item| %>
                <li><%= item %></li>
              <% end %>
            </ul>
          </div>
          <div class="release-notes-footer">
            <%= link_to "返回首頁", root_path, class: "release-notes-home-btn" %>
            <button type="button" id="release-notes-close-2" class="release-notes-close-btn">關閉</button>
          </div>
        </div>
      </div>

      <script>
        (function () {
          var overlay = document.getElementById('release-notes-overlay');
          var openBtn = document.getElementById('release-notes-btn');
          if (!overlay || !openBtn) return;
          function open() { overlay.classList.remove('hidden'); }
          function close() { overlay.classList.add('hidden'); }
          openBtn.addEventListener('click', open);
          document.getElementById('release-notes-close').addEventListener('click', close);
          document.getElementById('release-notes-close-2').addEventListener('click', close);
          overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !overlay.classList.contains('hidden')) close();
          });
        })();
      </script>
    <% end %>

  </body>
</html>
