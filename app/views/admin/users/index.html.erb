<% content_for :title, "帳戶管理 | FairPrice" %>

<% if flash[:notice] %>
  <div class="mb-4">
    <%= render FairValue::AlertComponent.new(message: flash[:notice], type: :success) %>
  </div>
<% end %>

<%= render Admin::Users::PageComponent.new(
      users:         @users,
      current_admin: current_user,
      dwell_totals:  @dwell_totals,
      daily_dwell:   @daily_dwell,
      last_activity: @last_activity,
      top_commands:  @top_commands
    ) %>
