{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,

    // 2026-08-29 開啟（global rules 要求）。當時 46 個錯誤全在 React/TSX 側，
    // 剛型別化完的 30 支 behaviors 一個都沒有——那批當初就寫得防禦性。
    "noUncheckedIndexedAccess": true,

    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // app/frontend 已無任何 .js——30 支 behaviors、共用模組與 entrypoints
    // 全部型別化完成（稽核 H-3 後續）。allowJs / checkJs 因此移除：
    // 現在每一支前端程式碼都在 strict 型別檢查之下，沒有例外。
    "forceConsistentCasingInFileNames": true
  },
  "include": ["app/frontend/**/*.ts", "app/frontend/**/*.tsx", "stories/**/*.ts", "stories/**/*.tsx"],
  "exclude": ["node_modules", "public"]
}
