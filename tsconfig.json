{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": false,

    // TODO（稽核 L-1／清單第二項）：開啟後現有程式碼還有約 30 個
    // 「可能是 undefined」要處理，集中在 OptionsChainTable.tsx 與 payoff.ts。
    // 那是獨立的一輪工作，不在 H-3 內嵌 JS 遷移的範圍內。
    "noUncheckedIndexedAccess": false,

    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // app/frontend 已無任何 .js——30 支 behaviors、共用模組與 entrypoints
    // 全部型別化完成（稽核 H-3 後續）。allowJs / checkJs 因此移除：
    // 現在每一支前端程式碼都在 strict 型別檢查之下，沒有例外。
    "forceConsistentCasingInFileNames": true
  },
  "include": ["app/frontend/**/*.ts", "app/frontend/**/*.tsx", "stories/**/*.ts", "stories/**/*.tsx"],
  "exclude": ["node_modules", "public"]
}
